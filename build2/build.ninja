  COMMAND = cd /tmp/opencode/progressive-core/build2/_deps/simdjson-build && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build _deps/simdjson-build/install/strip: phony _deps/simdjson-build/CMakeFiles/install/strip.util

